{
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "Bash(docker push:*)",
      "Edit(backend/models/**)",
      "Write(backend/models/**)",
      "Edit(verificacion/tests/**)",
      "Write(verificacion/tests/**)",
      "Edit(verificacion/linea_base.json)",
      "Write(verificacion/linea_base.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guardia.py\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/post_edicion.py\"", "timeout": 600 }
        ]
      }
    ]
  }
}
